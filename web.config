<configuration>
  <system.webServer>
    <handlers>
      <add name="aspNetCore"
           path="*"
           verb="*"
           modules="AspNetCoreModuleV2"
           resourceType="Unspecified" />
    </handlers>

    <aspNetCore processPath="dotnet"
                arguments=".\GestionaGatewayAPI.dll"
                stdoutLogEnabled="false"
                hostingModel="inprocess">
      <environmentVariables>
        <environmentVariable
          name="ASPNETCORE_ENVIRONMENT"
          value="Development" />
      </environmentVariables>
    </aspNetCore>
  </system.webServer>
</configuration>